<?xml version="1.0" encoding="utf-8"?>
<!--
  Clawd Watch Face - Watch Face Format package for Galaxy Watch7 (Wear OS 5+).
  hasCode must be false for a Watch Face Format face; everything lives in res/.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.redlinetech.clawdface"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="34" />
    <uses-feature android:name="android.hardware.type.watch" />

    <application
        android:label="@string/watch_face_name"
        android:icon="@drawable/preview"
        android:hasCode="false">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />
        <property
            android:name="com.google.wear.watchface.format.version"
            android:value="2" />
    </application>
</manifest>
